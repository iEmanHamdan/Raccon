diff --git a/backend/tests/test_password_reset.py b/backend/tests/test_password_reset.py
new file mode 100644
index 0000000..c97b5d9
--- /dev/null
+++ b/backend/tests/test_password_reset.py
@@ -0,0 +1,148 @@
+"""
+Forgot / reset password flow (user story: reset password).
+
+Runs on an in-memory SQLite database, so no Postgres or Resend key is needed:
+    cd backend
+    DATABASE_URL=sqlite:// SECRET_KEY=test RESEND_API_KEY=test MAX_EDIT_LIMIT=3 pytest tests -q
+"""
+import os
+
+os.environ.setdefault("DATABASE_URL", "sqlite://")
+os.environ.setdefault("SECRET_KEY", "test-secret")
+os.environ.setdefault("RESEND_API_KEY", "test")
+os.environ.setdefault("MAX_EDIT_LIMIT", "3")
+
+from datetime import datetime, timedelta, timezone
+
+import jwt
+import pytest
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+from sqlmodel import Session, SQLModel, create_engine
+from sqlalchemy.pool import StaticPool
+
+import models  # noqa: F401  (registers the tables)
+from api.auth import router as auth_router_module
+from core import security
+from core.database import get_session
+from services import auth_service
+
+EMAIL = "sara@example.com"
+OLD_PASSWORD = "oldpassword1"
+NEW_PASSWORD = "newpassword1"
+
+
+@pytest.fixture()
+def client(monkeypatch):
+    engine = create_engine("sqlite://", connect_args={"check_same_thread": False}, poolclass=StaticPool)
+    # only the users table: other tables use Postgres-only types (JSONB)
+    SQLModel.metadata.create_all(engine, tables=[models.User.__table__])
+
+    def session_override():
+        with Session(engine) as session:
+            yield session
+
+    sent = []
+    monkeypatch.setattr(auth_service, "send_password_reset_email", lambda to, token: sent.append((to, token)))
+
+    app = FastAPI()
+    app.include_router(auth_router_module.router)
+    app.dependency_overrides[get_session] = session_override
+    c = TestClient(app)
+    c.sent = sent
+
+    r = c.post("/auth/register", json={
+        "name": "Sara", "username": "sara", "email": EMAIL,
+        "phone_number": "512345678", "password": OLD_PASSWORD,
+    })
+    assert r.status_code == 200, r.text
+    return c
+
+
+def login(c, password):
+    return c.post("/auth/login", data={"username": EMAIL, "password": password})
+
+
+def request_link(c, email=EMAIL):
+    r = c.post("/auth/forgot-password", json={"email": email})
+    assert r.status_code == 200, r.text
+    return r
+
+
+def test_same_message_for_known_and_unknown_email(client):
+    known = request_link(client).json()
+    unknown = request_link(client, "nobody@example.com").json()
+    assert known == unknown
+    assert len(client.sent) == 1 and client.sent[0][0] == EMAIL
+
+
+def test_email_format_is_validated(client):
+    assert client.post("/auth/forgot-password", json={"email": "not-an-email"}).status_code == 422
+    assert client.sent == []
+
+
+def test_links_are_unique(client):
+    request_link(client)
+    request_link(client)
+    assert client.sent[0][1] != client.sent[1][1]
+
+
+def test_full_reset_then_login_with_new_password(client):
+    request_link(client)
+    token = client.sent[0][1]
+
+    assert client.post("/auth/verify-reset-token", json={"token": token}).status_code == 200
+    r = client.post("/auth/reset-password", json={"token": token, "new_password": NEW_PASSWORD})
+    assert r.status_code == 200, r.text
+
+    assert login(client, NEW_PASSWORD).status_code == 200
+    assert login(client, OLD_PASSWORD).status_code == 400
+
+
+def test_link_works_only_once(client):
+    request_link(client)
+    request_link(client)
+    first, second = client.sent[0][1], client.sent[1][1]
+
+    assert client.post("/auth/reset-password", json={"token": first, "new_password": NEW_PASSWORD}).status_code == 200
+
+    again = client.post("/auth/reset-password", json={"token": first, "new_password": "another123"})
+    assert again.status_code == 400 and again.json()["detail"] == "RESET_LINK_USED"
+    # older links sent before the change stop working too
+    other = client.post("/auth/verify-reset-token", json={"token": second})
+    assert other.status_code == 400 and other.json()["detail"] == "RESET_LINK_USED"
+
+
+def test_expired_link_is_rejected(client):
+    request_link(client)
+    payload = jwt.decode(client.sent[0][1], security.SECRET_KEY, algorithms=[security.ALGORITHM])
+    payload["exp"] = datetime.now(timezone.utc) - timedelta(minutes=1)
+    expired = jwt.encode(payload, security.SECRET_KEY, algorithm=security.ALGORITHM)
+
+    for path, body in [("/auth/verify-reset-token", {"token": expired}),
+                       ("/auth/reset-password", {"token": expired, "new_password": NEW_PASSWORD})]:
+        r = client.post(path, json=body)
+        assert r.status_code == 400 and r.json()["detail"] == "RESET_LINK_EXPIRED"
+
+
+def test_tampered_or_access_token_is_invalid(client):
+    r = client.post("/auth/verify-reset-token", json={"token": "abc.def.ghi"})
+    assert r.json()["detail"] == "RESET_LINK_INVALID"
+
+    access = login(client, OLD_PASSWORD).json()["access_token"]
+    r = client.post("/auth/verify-reset-token", json={"token": access})
+    assert r.json()["detail"] == "RESET_LINK_INVALID"
+
+
+def test_new_password_is_validated(client):
+    request_link(client)
+    token = client.sent[0][1]
+    assert client.post("/auth/reset-password", json={"token": token, "new_password": "short"}).status_code == 422
+    # a rejected attempt does not burn the link
+    assert client.post("/auth/verify-reset-token", json={"token": token}).status_code == 200
+
+
+def test_token_does_not_leak_the_password_hash(client):
+    request_link(client)
+    payload = jwt.decode(client.sent[0][1], options={"verify_signature": False})
+    assert "$2" not in payload["pwd"]
diff --git a/frontend/raccoon/src/api/authApi.js b/frontend/raccoon/src/api/authApi.js
index 91d28cb..675e82f 100644
--- a/frontend/raccoon/src/api/authApi.js
+++ b/frontend/raccoon/src/api/authApi.js
@@ -87,7 +87,47 @@ export async function getCurrentUser(accessToken) {
   return data;
 }
 
+// Shared helper for the password reset calls (JSON in, JSON out)
+async function postJson(path, body, errorMessage) {
+  const response = await fetch(`${API_URL}${path}`, {
+    method: "POST",
+    headers: {
+      "Content-Type": "application/json",
+    },
+    body: JSON.stringify(body),
+  });
+
+  const data = await response.json().catch(() => ({}));
+
+  if (!response.ok) {
+    const error = new Error(errorMessage);
+
+    error.status = response.status;
+    error.detail = data.detail; // RESET_LINK_EXPIRED | RESET_LINK_USED | RESET_LINK_INVALID | validation list
+    throw error;
+  }
+
+  return data;
+}
+
+// forgot-password: same answer whether the email has an account or not
+export function requestPasswordReset(email) {
+  return postJson("/auth/forgot-password", { email }, "Forgot password failed");
+}
+
+// verify-reset-token: check the link before showing the new password form
+export function verifyResetToken(token) {
+  return postJson("/auth/verify-reset-token", { token }, "Reset link check failed");
+}
+
+// reset-password: save the new password (the link stops working after this)
+export function resetPassword({ token, newPassword }) {
+  return postJson(
+    "/auth/reset-password",
+    { token, new_password: newPassword },
+    "Reset password failed",
+  );
+}
+
 //change-password
 //delete-account
