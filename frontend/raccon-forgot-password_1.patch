diff --git a/frontend/raccoon/src/pages/auth/ResetPasswordPage.jsx b/frontend/raccoon/src/pages/auth/ResetPasswordPage.jsx
new file mode 100644
index 0000000..040f757
--- /dev/null
+++ b/frontend/raccoon/src/pages/auth/ResetPasswordPage.jsx
@@ -0,0 +1,183 @@
+// Reset password logic: the email link opens /reset-password?token=...
+// 1. check the link  2. new password form  3. success → back to login
+import { useEffect, useState } from "react";
+import { Link, useNavigate, useSearchParams } from "react-router-dom";
+import { resetPassword, verifyResetToken } from "../../api/authApi";
+import AuthLayout from "../../components/layout/AuthLayout";
+import AuthPromo from "../../components/layout/AuthPromo";
+import ResetPasswordForm from "../../components/auth/ResetPasswordForm";
+import AuthStatus from "../../components/auth/AuthStatus";
+import Button from "../../components/ui/Button";
+import DehmScan from "../../components/ui/DehmScan";
+
+// Backend codes → what the user reads
+const LINK_ERRORS = {
+  RESET_LINK_EXPIRED: {
+    title: "انتهت صلاحية الرابط",
+    text: "رابط إعادة التعيين صالح لمدة 15 دقيقة بس. اطلب رابط جديد وكمّل.",
+  },
+  RESET_LINK_USED: {
+    title: "الرابط مستخدم من قبل",
+    text: "هذا الرابط استُخدم لتغيير كلمة المرور، وكل رابط يشتغل مرة وحدة. إذا تحتاج تغيّرها مرة ثانية، اطلب رابط جديد.",
+  },
+  RESET_LINK_INVALID: {
+    title: "الرابط غير صالح",
+    text: "تأكد إنك فتحت الرابط كامل من الإيميل، أو اطلب رابط جديد.",
+  },
+};
+
+export default function ResetPasswordPage() {
+  const [searchParams] = useSearchParams();
+  const navigate = useNavigate();
+  const token = searchParams.get("token") || "";
+
+  // checking | form | success | linkError | checkFailed
+  const [step, setStep] = useState(token ? "checking" : "linkError");
+  const [linkError, setLinkError] = useState(token ? "" : "RESET_LINK_INVALID");
+  const [isSubmitting, setIsSubmitting] = useState(false);
+  const [serverError, setServerError] = useState("");
+
+  // 1. Check the link as soon as the page opens
+  useEffect(() => {
+    if (!token) {
+      return undefined;
+    }
+
+    let active = true;
+
+    async function checkLink() {
+      try {
+        await verifyResetToken(token);
+        if (active) setStep("form");
+      } catch (error) {
+        if (!active) return;
+
+        if (LINK_ERRORS[error.detail]) {
+          setLinkError(error.detail);
+          setStep("linkError");
+        } else {
+          setStep("checkFailed"); // network or server problem
+        }
+      }
+    }
+
+    checkLink();
+
+    return () => {
+      active = false;
+    };
+  }, [token]);
+
+  // 2. Save the new password
+  async function handleReset(newPassword) {
+    if (isSubmitting) {
+      return;
+    }
+
+    setIsSubmitting(true);
+    setServerError("");
+
+    try {
+      await resetPassword({ token, newPassword });
+      setStep("success");
+    } catch (error) {
+      if (LINK_ERRORS[error.detail]) {
+        // e.g. the link expired while the user was typing
+        setLinkError(error.detail);
+        setStep("linkError");
+      } else if (error.status === 422) {
+        setServerError("تأكد إن كلمة المرور من 8 إلى 72 حرفًا.");
+      } else {
+        setServerError("تعذر حفظ كلمة المرور. حاول مرة ثانية.");
+      }
+    } finally {
+      setIsSubmitting(false);
+    }
+  }
+
+  const mobileTitles = {
+    checking: "لحظة…",
+    form: "عيّن كلمة مرور جديدة",
+    success: "تم تغيير كلمة المرور",
+    linkError: LINK_ERRORS[linkError]?.title || "الرابط غير صالح",
+    checkFailed: "تعذر التحقق من الرابط",
+  };
+
+  return (
+    <AuthLayout
+      showTabs={false}
+      promo={
+        <AuthPromo
+          scene={<DehmScan />}
+          mobileTitle={mobileTitles[step]}
+          variant="login"
+        />
+      }
+    >
+      <div className="login-page">
+        {step === "checking" && (
+          <AuthStatus tone="loading" title="لحظة، نتحقق من الرابط…" />
+        )}
+
+        {step === "form" && (
+          <ResetPasswordForm
+            onSubmit={handleReset}
+            isSubmitting={isSubmitting}
+            serverError={serverError}
+            onEdit={() => setServerError("")}
+          />
+        )}
+
+        {step === "success" && (
+          <AuthStatus
+            tone="success"
+            title="تم تغيير كلمة المرور"
+            text="تقدر الحين تدخل حسابك بكلمة المرور الجديدة."
+          >
+            <Button
+              variant="primary"
+              fullWidth
+              onClick={() =>
+                navigate("/login", { replace: true, state: { passwordReset: true } })
+              }
+            >
+              ارجع لتسجيل الدخول
+            </Button>
+          </AuthStatus>
+        )}
+
+        {step === "linkError" && (
+          <AuthStatus
+            tone="error"
+            title={LINK_ERRORS[linkError].title}
+            text={LINK_ERRORS[linkError].text}
+          >
+            <Button
+              variant="primary"
+              fullWidth
+              onClick={() => navigate("/forgot-password", { replace: true })}
+            >
+              اطلب رابط جديد
+            </Button>
+
+            <Link className="auth-status__link" to="/login">
+              ارجع لتسجيل الدخول
+            </Link>
+          </AuthStatus>
+        )}
+
+        {step === "checkFailed" && (
+          <AuthStatus
+            tone="error"
+            title="تعذر التحقق من الرابط"
+            text="صار خطأ في الاتصال. تأكد من الإنترنت وحاول مرة ثانية."
+          >
+            <Button variant="primary" fullWidth onClick={() => window.location.reload()}>
+              حاول مرة ثانية
+            </Button>
+          </AuthStatus>
+        )}
+      </div>
+    </AuthLayout>
+  );
+}
